[Unit]
Description=Biscuit Trocador relay
After=network-online.target
Wants=network-online.target

[Service]
# Replace the age1... public key. Drop the two -site-* lines to run the relay alone.
ExecStart=/usr/local/bin/biscuit-relay serve \
    -domain relay.biscuitwallet.com \
    -site-domain biscuitwallet.com \
    -site-dir /srv/biscuit-site \
    -onion-listen 127.0.0.1:8081 \
    -onion-address biscuit6qpejzxfr7us7oibhjasvrozfeno7xonffzzoj4lmw6o3kbyd.onion \
    -key-file %d/trocador-key \
    -pegasus-public-key-file %d/pegasus-public-key \
    -pegasus-secret-file %d/pegasus-secret \
    -etz \
    -stereoswap-key-file %d/stereoswap-api-key \
    -stereoswap-referral-file %d/stereoswap-referral \
    -recipient age1REPLACE_WITH_PUBLIC_KEY \
    -log-dir /var/lib/biscuit-relay/trades \
    -cert-dir /var/lib/biscuit-relay/certs
# The partner keys are handed to the service only, never readable by other users.
LoadCredential=trocador-key:/etc/biscuit-relay/trocador-key
LoadCredential=pegasus-public-key:/etc/biscuit-relay/pegasus-public-key
LoadCredential=pegasus-secret:/etc/biscuit-relay/pegasus-secret
LoadCredential=stereoswap-api-key:/etc/biscuit-relay/stereoswap-api-key
LoadCredential=stereoswap-referral:/etc/biscuit-relay/stereoswap-referral
Restart=always
RestartSec=5

DynamicUser=yes
StateDirectory=biscuit-relay
StateDirectoryMode=0700
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
